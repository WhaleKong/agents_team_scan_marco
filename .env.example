# API Keys for Quant Macro Agent Team
# Copy this file to .env and fill in your keys

# FRED (Federal Reserve Economic Data)
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage (Macro indicators, FX, Crypto)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# NewsAPI (Aggregated news)
# Get key at: https://newsapi.org/register
NEWSAPI_API_KEY=

# Finnhub (Earnings, SEC filings)
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# SerpAPI (Google News, Google Finance, Google Search)
# Get key at: https://serpapi.com/manage-api-key
# Free tier: 100 searches/month
SERPAPI_API_KEY=
